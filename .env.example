# make run-strata generates a random shared key if missing or empty.
STRATA_API_KEY=

# Automatically detected from host GPU devices by make run-strata / make run-colibri.
# Numeric IDs are refreshed on every run, including after moving to another host.
RENDER_GID=
VIDEO_GID=

# Colibri: filename relative to MODELS_DIR, first shard for split GGUFs.
COLIBRI_GGUF=flint-UD-Q4_K_XL.gguf
COLIBRI_CTX=8192
COLIBRI_RAM=48
# Optional Colibri model mount (also pass MODELS_DIR to make downloads).
# MODELS_DIR=/path/to/models
