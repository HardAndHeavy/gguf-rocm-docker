# make run-strata / run-colibri generates a random shared key if missing.
STRATA_API_KEY=
COLI_API_KEY=

# Automatically detected from host GPU devices; never use group names here.
RENDER_GID=
VIDEO_GID=

# Backend and UI host ports. Only one backend can own 8080 at a time.
COLIBRI_PORT=8080
STRATA_PORT=8080
LLAMA_PORT=8080
OPENWEBUI_PORT=80

# Explicit non-overlapping networks avoid Docker's exhausted dynamic address
# pools on hosts with many short-lived test projects. Change if LANs conflict.
GGUF_ROCM_SUBNET=192.168.240.0/24
GGUF_ROCM_BENCH_SUBNET=192.168.241.0/24

# Explicit llama.cpp model selection; direct API is bound to 127.0.0.1.
LLAMA_GGUF=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
LLAMA_MODEL_ID=qwen36-llama
LLAMA_CTX=32768
LLAMA_N_GPU_LAYERS=-1
LLAMA_THREADS=8
LLAMA_FLASH_ATTN=on
# Qwen3.6 MTP-GGUF can use draft-mtp; keep none for the non-speculative baseline.
LLAMA_SPEC_TYPE=none
LLAMA_SPEC_DRAFT_N_MAX=3

# Strata preset. For Qwen3.6 use FAMILY=qwen36, MODEL=ud-q4_k_xl and
# MODEL_PATH=/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf.
STRATA_FAMILY=qwen36
STRATA_MODEL=ud-q4_k_xl
STRATA_MODEL_PATH=/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
STRATA_CONTEXT=32k
STRATA_PARALLEL=2
STRATA_VISION=off
STRATA_TUNE=skip
STRATA_MTP=on
STRATA_DRAFTING=mtp
STRATA_BATCH_MTP=1
PRESET=qwen36-work
STRATA_SET=

# Colibri: filename relative to MODELS_DIR, first shard for split GGUFs.
# COLIBRI_GGUF=Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf
COLIBRI_GGUF=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
COLIBRI_CTX=32768
COLIBRI_RAM=48
# Optional model directory, image and ROCm build target (rebuild after changing it).
# MODELS_DIR=/path/to/models
# COLIBRI_IMAGE=gguf-rocm-colibri:local
# COLIBRI_STATE_DIR=./data/colibri
COLIBRI_HIP_ARCH=gfx1201
# COLIBRI_ROCM_IMAGE=llama-rocm:3.0.2

# Optional Qwen MTP head. Q38_MTP=1 forces the CPU draft head on ROCm;
# measured slower on R9700, so execution remains off by default.
# COLIBRI_MTP=mtp-Qwen3.8-Flash-Next-Q2_0.gguf
Q38_MTP=0

# This Qwen3.6 GGUF embeds blk.40.nextn.*; pinned Colibri expects mtp.*.
# Non-MTP works, but Q36_MTP=1 is unsupported for this container layout.
Q36_MTP=0
Q36_MTP_DRAFTS=1

# Qwen fast profile: pinned host pool costs ~35 GiB RAM but is much faster.
# Setting CHAIN_POOL=0 saves RAM and startup time, at a large latency cost.
COLI_CUDA_CHAIN_POOL=1
COLI_CUDA_CHAIN_LAYERWISE=1
OMP_NUM_THREADS=8

# Advanced optional Colibri CLI overrides; empty means upstream default.
COLIBRI_CAP=
COLIBRI_VRAM=
COLIBRI_KV_SLOTS=
COLIBRI_POLICY=
